{
  "schema_version": "1.0.0",
  "source_system": "github",
  "account": "defulat-coder",
  "api_version": "2026-03-10",
  "storage": {
    "raw_root": "data/sensitive/github/starred/raw",
    "derived_root": "data/sensitive/github/starred/derived"
  },
  "collections": {
    "owned": true,
    "starred": true,
    "watched": true
  },
  "readme": {
