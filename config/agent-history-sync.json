{
  "schema_version": "1.0.0",
  "source_system": "agent-history",
  "storage": {
    "raw_root": "data/private/agent-history/raw"
  },
  "projection": {
    "max_jsonl_line_bytes": 8388608
  },
  "codex": {
    "session_roots": [
      {
        "path": "~/.codex/sessions",
        "state": "active",
        "source_prefix": "sessions"
      },
      {
        "path": "~/.codex/archived_sessions",
        "state": "archived",
        "source_prefix": "archived_sessions"
      }
    ],
    "session_index": "~/.codex/session_index.jsonl",
    "memory_database": "~/.codex/memories_1.sqlite",
    "memory_root": "~/.codex/memories",
    "memory_excludes": [
      ".git",
      "xcrun_db"
    ]
  },
  "claude_code": {
    "projects_root": "~/.claude/projects",
    "prompt_history": "~/.claude/history.jsonl",
    "session_metadata_root": "~/.claude/sessions",
    "global_memory_files": [
      "~/.claude/CLAUDE.md"
    ]
  },
  "retention": {
    "keep_snapshot_history": true
  }
}
