{
  "schema_version": "1.0.0",
  "api": {
    "base_url": "https://www.yuque.com/api/v2",
    "repo_page_size": 100,
    "doc_page_size": 100,
    "note_page_size": 20,
    "concurrency": 4,
    "timeout_ms": 30000,
    "retry": {
      "attempts": 5,
      "base_delay_ms": 750
    }
  },
  "scope": {
    "personal_books": true,
    "groups": false,
    "note_statuses": [0, 9],
    "include_toc": true,
    "include_legacy_doc": true,
    "include_ymd_doc": true,
    "mirror_assets": true
  },
  "storage": {
    "raw_root": "data/private/yuque/raw",
    "runtime_root": "var/yuque-sync"
  }
}
