<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>site.personal.ai-news-backfill</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_BIN__/node</string>
    <string>__REPO_ROOT__/scripts/ai-news-sync.mjs</string>
    <string>--backfill</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>17</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/var/ai-news/backfill.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/var/ai-news/backfill.log</string>
</dict>
</plist>
