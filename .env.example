# Pi Coding Agent（本机 X 解析）
KIMI_API_KEY=

# 问答匿名会话：至少 32 个随机字符。浏览器指纹只用于生成 HMAC，会话文件不保存原始指纹。
# Vercel 上会把 JSONL 会话持久保存到私有的 Supabase Storage，不需要新增客户端变量。
ASK_SESSION_SECRET=
# 可选：会话 JSONL 文件的无活动清理时间（小时），默认 24。
ASK_SESSION_RETENTION_HOURS=24

# Supabase：同步脚本用 service role；网站仅用 publishable key 读取公开策展表。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 可选：用于线上读取公开 GitHub 仓库树和文件，避免匿名 GitHub API 限流。
# 只在服务端配置，绝不能使用 NEXT_PUBLIC_ 前缀。
GITHUB_TOKEN=

# 每日动态按需失效：同步完成后 POST /api/revalidate 的 Bearer 密钥（至少 32 个随机字符）。
# 只在服务端与 GitHub Actions secrets 配置，绝不能使用 NEXT_PUBLIC_ 前缀。
AI_NEWS_REVALIDATE_SECRET=
