{
  "name": "chen-yuan-personal-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "portless": {
    "name": "personal-site",
    "script": "dev",
    "appPort": 3000
  },
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "dev:domain": "portless",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint --max-warnings=0 --no-error-on-unmatched-pattern 'app/**/*.{ts,tsx}' 'components/**/*.{ts,tsx}' 'lib/**/*.{ts,tsx}' '*.config.{js,mjs,ts}'",
    "typecheck": "node scripts/tsc7.mjs --noEmit",
    "test": "vitest run --passWithNoTests && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "curation:prepare": "node scripts/x-curation-prepare.mjs",
    "curation:recover": "node scripts/recover-x-curation-queue.mjs",
    "curation:import": "node scripts/x-curation-import-bird.mjs",
    "curation:fetch": "node scripts/x-curation-sync.mjs --fetch-only",
    "curation:history": "node scripts/x-curation-sync.mjs --history",
    "curation:sync": "node scripts/x-curation-sync.mjs",
    "curation:sync:kimi": "node scripts/x-curation-sync.mjs --engine pi",
    "curation:sync:luna": "node scripts/x-curation-sync.mjs --engine codex-cli --model gpt-5.6-luna --reasoning-effort max",
    "curation:enrich": "node scripts/x-curation-enrich.mjs",
    "curation:classify-design": "node scripts/x-curation-enrich.mjs --design-only --engine codex-cli --model gpt-5.6-luna --reasoning-effort high --concurrency 40",
    "curation:build": "node scripts/build-curation-content.mjs",
    "curation:publish": "node scripts/build-curation-sqlite.mjs",
    "douyin:curation": "node scripts/douyin-curation.mjs",
    "douyin:sync": "node scripts/douyin-full-sync.mjs",
    "github:starred:sync": "node scripts/github-starred.mjs sync",
    "github:starred:init": "node scripts/github-starred.mjs init",
    "github:starred:daily": "node scripts/github-starred.mjs daily",
    "github:starred:analyze": "node scripts/github-starred.mjs analyze",
    "github:starred:analyze:pi": "node scripts/github-starred.mjs analyze --engine pi",
    "github:starred:publish": "node scripts/github-starred.mjs publish",
    "ai-news:sync": "node scripts/ai-news-sync.mjs",
    "ai-news:backfill": "node scripts/ai-news-sync.mjs --backfill",
    "focus:status": "node scripts/focus-status.mjs",
    "health:production": "node scripts/check-production-health.mjs",
    "vectors:index": "node scripts/local-vectors.mjs index",
    "vectors:search": "node scripts/local-vectors.mjs search",
    "github:starred:run": "node scripts/github-starred.mjs run",
    "projects:sync": "node scripts/projects-sync.mjs",
    "projects:sync:pi": "node scripts/projects-sync.mjs --engine pi",
    "projects:publish": "node scripts/projects-sync.mjs --publish",
    "supabase:push": "node scripts/supabase-db-push.mjs",
    "git:safety": "node scripts/verify-git-safety.mjs --range HEAD",
    "git:hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs --if-present"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@huggingface/transformers": "4.2.0",
    "@shadcn/react": "^0.3.0",
    "@supabase/supabase-js": "2.112.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.33.0",
    "motion": "^13.1.1",
    "next": "16.3.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sqlite-vec": "0.1.9",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@steipete/bird": "^0.8.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "dayjs": "^1.11.23",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "portless": "^0.15.5",
    "postcss": "8.5.26",
    "shadcn": "4.18.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
