{
  "name": "chen-yuan-personal-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint --max-warnings=0 --no-error-on-unmatched-pattern 'app/**/*.{ts,tsx}' 'components/**/*.{ts,tsx}' 'lib/**/*.{ts,tsx}' 'scripts/build-public-content.mjs' 'scripts/lib/public-content-schema.mjs' 'scripts/lib/site-verification.mjs' 'scripts/verify-public-content.mjs' 'scripts/verify-site-*.mjs' 'tests/**/*.test.{ts,tsx}' 'tests/**/*.vitest.mjs' '*.config.{js,mjs,ts}'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test tests/*.test.mjs",
    "public-content:build": "node scripts/build-public-content.mjs",
    "public-content:verify": "node scripts/verify-public-content.mjs",
    "verify:content": "pnpm public-content:verify && node scripts/verify-site-content.mjs",
    "verify:quick": "node scripts/verify-site-quick.mjs",
    "verify:visual": "node scripts/verify-site-visual.mjs",
    "data:sync:yuque": "node scripts/yuque-sync.mjs",
    "data:resume:yuque": "node scripts/yuque-api-resume.mjs",
    "data:sync:yuque-assets": "node scripts/yuque-assets.mjs",
    "data:finalize:yuque": "node scripts/yuque-finalize.mjs",
    "data:verify:yuque": "node scripts/verify-yuque.mjs",
    "data:sync:github": "node scripts/github-sync.mjs",
    "data:verify:github": "node scripts/verify-github.mjs",
    "data:sync:agent-history": "node scripts/agent-history-sync.mjs",
    "data:verify:agent-history": "node scripts/verify-agent-history.mjs",
    "git:safety": "node scripts/verify-git-safety.mjs --range HEAD",
    "git:hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs --if-present",
    "data:build:okf": "node scripts/build-okf.mjs",
    "data:verify:okf": "node scripts/verify-okf.mjs && node scripts/verify-okf-curation.mjs && node scripts/verify-github-okf.mjs && node scripts/verify-agent-history-okf.mjs",
    "data:update:github": "npm run data:sync:github && npm run data:verify:github && npm run data:build:okf && npm run data:verify:okf",
    "data:update:agent-history": "npm run data:sync:agent-history && npm run data:verify:agent-history && npm run data:build:okf && npm run data:verify:okf"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.25.0",
    "next": "16.2.10",
    "radix-ui": "1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "jsdom": "29.1.1",
    "postcss": "8.5.19",
    "shadcn": "4.13.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
