{
  "name": "chen-yuan-personal-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint --max-warnings=0 --no-error-on-unmatched-pattern 'app/**/*.{ts,tsx}' 'components/**/*.{ts,tsx}' 'lib/**/*.{ts,tsx}' '*.config.{js,mjs,ts}'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests && node --test tests/*.test.mjs",
    "curation:prepare": "node scripts/x-curation-prepare.mjs",
    "curation:import": "node scripts/x-curation-import-bird.mjs",
    "curation:fetch": "node scripts/x-curation-sync.mjs --fetch-only",
    "curation:history": "node scripts/x-curation-sync.mjs --history",
    "curation:sync": "node scripts/x-curation-sync.mjs",
    "curation:enrich": "node scripts/x-curation-enrich.mjs",
    "curation:build": "node scripts/build-curation-content.mjs",
    "curation:publish": "node scripts/x-curation-publish-supabase.mjs",
    "github:starred:sync": "node scripts/github-starred.mjs sync",
    "github:starred:analyze": "node scripts/github-starred.mjs analyze",
    "github:starred:publish": "node scripts/github-starred.mjs publish",
    "github:starred:run": "node scripts/github-starred.mjs run",
    "supabase:push": "node scripts/supabase-db-push.mjs",
    "git:safety": "node scripts/verify-git-safety.mjs --range HEAD",
    "git:hooks:install": "node scripts/install-git-hooks.mjs",
    "prepare": "node scripts/install-git-hooks.mjs --if-present"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@supabase/supabase-js": "2.112.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.25.0",
    "next": "16.3.0-canary.89",
    "radix-ui": "1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@steipete/bird": "^0.8.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dayjs": "^1.11.21",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0-canary.89",
    "jsdom": "29.1.1",
    "postcss": "8.5.19",
    "shadcn": "4.13.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
